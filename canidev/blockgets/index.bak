/**
* @ignore
*/
define('IN_PHPBB', true);
$phpbb_root_path = (defined('PHPBB_ROOT_PATH')) ? PHPBB_ROOT_PATH : '{ROOT_PATH}';
$phpEx = substr(strrchr(__FILE__, '.'), 1);
include($phpbb_root_path . 'common.' . $phpEx);

if(file_exists($phpbb_root_path . 'includes/functions_url_matcher.' . $phpEx))
{
	include($phpbb_root_path . 'includes/functions_url_matcher.' . $phpEx);
}

if($request->variable('install', false))
{
	echo 'ok';
	exit_handler();
}

// Start session management
$user->session_begin();
$auth->acl($user->data);
$user->setup('app');

$http_kernel 		= $phpbb_container->get('http_kernel');
$symfony_request	= $phpbb_container->get('symfony_request');

if(preg_replace('#\?(.*?)$#', '', $request->server('REQUEST_URI', '')) == '/')
{
	$symfony_request->attributes->set('_controller', 'canidev.blockgets.controller:display');
}

$response = $http_kernel->handle($symfony_request);
$response->send();
$http_kernel->terminate($symfony_request, $response);

?>