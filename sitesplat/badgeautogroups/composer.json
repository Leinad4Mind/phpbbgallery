{
    "name": "sitesplat/badgeautogroups",
    "type": "phpbb-extension",
    "description": "BBAwards Custom Autogroup functions for the BBAwards extension",
    "homepage": "http://sitesplat.com",
    "version": "1.0.2",
    "keywords": ["autogroup", "extension", "badge", "award", "sitesplat", "customization", "rewards", "FLATBOOTS", "bootstrap"],
    "license": "Proprietary/All rights reserved",
    "authors": [
        {
            "name": "SiteSplat",
            "email": "info@sitesplat.com",
            "homepage": "http://sitesplat.com"
        }
    ],
    "require": {
        "php": ">=5.3.3",
		"composer/installers": "~1.0"
    },
    "require-dev": {
        "phpbb/epv": "dev-master"
    },
    "extra": {
        "display-name": "BBAwards Autogroups",
        "soft-require": {
			"phpbb/phpbb": ">=3.1.0-RC3,<3.2.*@dev"
        },
       "version-check": {
            "host": "www.sitesplat.com",
            "directory": "/updatecheck/phpbb31/ext",
            "filename": "bbawards_autogroup.json"
		}
    }
}
