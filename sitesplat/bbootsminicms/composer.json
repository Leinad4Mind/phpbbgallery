			"email": "info@sitesplat.com",
			"homepage": "http://www.sitesplat.com"
		},
		{
			"name": "John Peskens",
			"email": "info@forumhulp.com",
			"homepage": "http://forumhulp.com"
		}
	],
	"require": {
		"php": ">=5.3.3"
	},
	"extra": {
		"display-name": "BBOOTS Mini CMS",
