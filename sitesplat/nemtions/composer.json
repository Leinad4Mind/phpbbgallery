{
	"name": "sitesplat/nemtions",
	"type": "phpbb-extension",
	"description": "Allows a baord running SiteSplat's themes to mention users Twitter/Github style with the @username. It also supports the @group. The mentioned user or leader of X group will receive a notification an link to the mentioned post",
	"homepage": "http://www.sitesplat.com",
	"version": "1.2.1",
	"keywords": ["phpbb", "extension", "reaction", "topic", "premium", "sitesplat", "mention", "username"],
	"license": "Proprietary/All rights reserved",
	"authors": [
		{
			"name": "ThemeSplat (SiteSplat)",
			"email": "info@sitesplat.com",
			"homepage": "http://www.sitesplat.com",
			"role": "Developer"
		}
	],
	"require": {
		"php": ">=5.3.3",
		"composer/installers": "~1.0"
	},
	"extra": {
		"display-name": "BB@mention",
		"soft-require": {
			"phpbb/phpbb": "3.1.*"
		},
		"version-check": {
            "host": "www.sitesplat.com",
            "directory": "/updatecheck/phpbb31/ext",
            "filename": "bbmention.json"
		}

	}
}