{
	"name": "sitesplat/fltl",
	"type": "phpbb-extension",
	"description": "Fancy Lazy Topics Loader - The Ajax way :-) ",
	"version": "2.1.17",
	"keywords": ["phpbb", "extension", "ajax", "topic loader"],
	"license": "Proprietary/All rights reserved",
	"authors": [
		{
			"name": "SiteSplat",
			"email": "info@sitesplat.com",
			"homepage": "https://sitesplat.com"
		}
	],
	"require": {
		"php": ">=5.4",
		"composer/installers": "~1.0"
	},
	"extra": {
		"display-name": "Fancy Lazy Topics Loader",
		"soft-require": {
			"phpbb/phpbb": ">=3.2.0,<3.3.0@dev"
		},
		"version-check": {
            "host": "sitesplat.com",
            "directory": "/updatecheck/phpbb32/ext",
