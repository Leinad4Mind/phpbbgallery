{
	"name": "sitesplat/titlesandavatars",
	"type": "phpbb-extension",
	"description": "Enable the display of the user avatars in various forum locations like the forumlist, online list, memberslist and in topics as a contributors list. Allows enable/disable for each options.",
	"homepage": "http://sitesplat.com",
	"version": "1.2.4",
	"keywords": ["phpbb", "extension", "avatar", "users", "BBOOTS", "FLATBOOTS", "sitesplat"],
	"license": "Proprietary/All rights reserved",
	"authors": [
		{
			"name": "SiteSplat",
			"email": "info@sitesplat.com",
			"homepage": "http://sitesplat.com"
		}
	],
	"require": {
		"php": ">=5.3.3",
		"composer/installers": "~1.0"
	},
	"require-dev": {
		"phpbb/epv": "dev-master"
	},
	"extra": {
		"display-name": "BBAvatars",
		"soft-require": {
			"phpbb/phpbb": ">=3.1.7,<3.2.*@dev"
		},
		"version-check": {
            "host": "www.sitesplat.com",
            "directory": "/updatecheck/phpbb31/ext",
            "filename": "title_avatars.json"
		}

	}
}
