{
    "name": "sitesplat/bbgdpr",
    "type": "phpbb-extension",
    "description": "BBgdpr aims at making your phpBB board compatible with the GDPR policy, keeping you the Admin out of trouble :-)",
	"homepage": "https://sitesplat.com",
    "version": "1.0.4",
    "time": "2018-04-23",
	"keywords": ["phpbb", "extension", "privacy", "user", "premium", "sitesplat", "cookie", "gdpr", "security"],
	"license": "Proprietary/All rights reserved",
	"authors": [
		{
			"name": "SiteSplat",
			"email": "info@sitesplat.com",
			"homepage": "https://sitesplat.com"
		}
	],
    "require": {
        "php": ">=5.4",
        "composer/installers": "~1.0",
        "fzaninotto/faker": "^1.7",
        "geoip2/geoip2": "^2.9"
    },
    "extra": {
        "display-name": "BBgdpr",
        "soft-require": {
            "phpbb/phpbb": ">=3.2.0,<3.3.0@dev"
        },
		"version-check": {
            "host": "sitesplat.com",
            "directory": "/updatecheck/phpbb32/ext",
            "filename": "bbgdpr.json",
			"ssl": true
		}
    }
}
