{
	"name": "sitesplat/badge",
	"type": "phpbb-extension",
	"description": "BBAwards is a system that allows your forum members to truly engage with the community rewarding them with special badges. Custom badge awards are available plus tons of combinations possible for specific conditions.",
	"homepage": "http://sitesplat.com",
	"version": "1.4.1",
	"keywords": ["phpbb", "extension", "badge", "award", "sitesplat", "customization", "rewards", "FLATBOOTS", "bootstrap"],
	"license": "Proprietary/All rights reserved",
	"authors": [
		{
			"name": "SiteSplat",
			"email": "info@sitesplat.com",
			"homepage": "http://sitesplat.com"
		}
	],
	"require": {
		"php": ">=5.3.3",
		"composer/installers": "~1.0"
	},
	"require-dev": {
		"phpbb/epv": "dev-master"
	},
	"extra": {
		"display-name": "BBAwards",
		"soft-require": {
			"phpbb/phpbb": ">=3.2.0"
		},
		"version-check": {
            "host": "www.sitesplat.com",
            "directory": "/updatecheck/phpbb32/ext",
            "filename": "bbawards.json"
		}

	}
}
