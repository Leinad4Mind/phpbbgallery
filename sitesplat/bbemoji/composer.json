{
	"name": "sitesplat/bbemoji",
	"type": "phpbb-extension",
	"description": "Enables Unicode emoji - By default it uses a CDN to serve the emojis and it uses SVG format. It also provides a local fallback if the CDN fails. You can also style the emoji via CSS. The class used is emoji.",
	"version": "2.1.2",
	"keywords": ["phpbb","emoji"],
	"license": "Proprietary/All rights reserved",
	"authors": [
		{
			"name": "SiteSplat",
			"email": "info@sitesplat.com",
			"homepage": "https://sitesplat.com"
		}
	],
	"require": {
		"php": ">=5.4",
		"composer/installers": "~1.0"
	},
	"extra": {
		"display-name": "BBemoji",
		"soft-require": {
			"phpbb/phpbb": "3.1.*"
		},
		"version-check": {
            "host": "sitesplat.com",
            "directory": "/updatecheck/phpbb32/ext",
            "filename": "bbemoji.json",
			"ssl": true
		}
	}
}