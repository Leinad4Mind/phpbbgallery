{
	"name": "sitesplat/snappy",
	"type": "phpbb-extension",
	"description": "Snappy Smart Reply",
	"homepage": "http://sitesplat.com",
	"version": "1.1.5",
	"keywords": ["phpbb", "extension", "bbcode", "quick reply"],
	"license": "Proprietary/All rights reserved",
	"authors": [
		{
			"name": "SiteSplat",
			"email": "info@sitesplat.com",
			"homepage": "http://sitesplat.com"
		}
	],
	"require": {
		"php": ">=5.3.3",
		"composer/installers": "~1.0"
	},
	"require-dev": {
		"phpbb/epv": "dev-master"
	},
	"extra": {
		"display-name": "Snappy Smart Reply",
		"soft-require": {
			"phpbb/phpbb": ">=3.1.0,<3.2.*@dev"
		},
		"version-check": {
            "host": "sitesplat.com",
            "directory": "/updatecheck/phpbb31/ext",
            "filename": "snappy.json"
		}

