{
	"name": "sitesplat/bblightbox",
	"type": "phpbb-extension",
	"description": "The perfect Lightbox for a phpBB forum.",
	"homepage": "http://sitesplat.com",
	"version": "1.0.1",
	"keywords": ["phpbb", "extension", "premium", "cosmetic", "SiteSplat"],
	"license": "Proprietary/All rights reserved",
	"authors": [
		{
			"name": "SiteSplat",
			"email": "info@sitesplat.com",
			"homepage": "http://sitesplat.com"
		}
	],
	"require": {
		"php": ">=5.4",
		"composer/installers": "~1.0"
	},
	"extra": {
		"display-name": "BBlightBox",
		"soft-require": {
			"phpbb/phpbb": ">=3.2.0,<3.3@dev"
		},
		"version-check": {
            "host": "www.sitesplat.com",
            "directory": "/updatecheck/phpbb32/ext",
            "filename": "bblightbox.json"
		}
	}
}
