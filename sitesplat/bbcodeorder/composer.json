{
    "name": "sitesplat/bbcodeorder",
    "type": "phpbb-extension",
    "description": "Enhances default BBcodes and allows some essential combinations. Custom icons, Group permission, sorting, ordering and more...",
    "homepage": "https://sitesplat.com",
    "version": "1.0.12",
    "license": "Proprietary/All rights reserved",
    "authors": [
        {
            "name": "SiteSplat",
            "email": "info@sitesplat.com",
            "homepage": "https://sitesplat.com"
        }
    ],
    "require": {
        "php": ">=5.4",
        "composer/installers": "~1.0"
    },
    "extra": {
        "display-name": "BBCodeOrder+",
        "soft-require": {
            "phpbb/phpbb": ">=3.1.0"
        },
		"version-check": {
            "host": "sitesplat.com",
            "directory": "/updatecheck/phpbb32/ext",
            "filename": "bbcodeorder.json",
			"ssl": true
		}
    }
}
