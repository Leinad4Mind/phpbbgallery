{
    "name": "sitesplat/bbinfinitepagination",
    "type": "phpbb-extension",
    "description": "Loads new topics, posts and members automatically after scrolling to the bottom.",
    "homepage": "http://sitesplat.com",
	"version": "1.0.0",
	"keywords": ["sitesplat", "phpbb", "extension", "ui", "cosmetic", "pagination"],
	"license": "Proprietary/All rights reserved",
	"authors": [
		{
			"name": "SiteSplat",
			"email": "info@sitesplat.com",
			"homepage": "http://sitesplat.com"
		}
	],
    "support": {
        "email": "info@sitesplat.com"
    },
    "require": {
        "php": ">=5.4",
        "composer/installers": "~1.0"
    },
    "extra": {
        "display-name": "BBinfinitepagination",
        "soft-require": {
            "phpbb/phpbb": ">=3.2.0,<3.3.0@dev"
        },
		"version-check": {
            "host": "www.sitesplat.com",
            "directory": "/updatecheck/phpbb32/ext",
            "filename": "bbinfinitepagination.json"
		}
    }
}
