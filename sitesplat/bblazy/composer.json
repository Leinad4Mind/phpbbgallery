{
	"name": "sitesplat/bblazy",
	"type": "phpbb-extension",
	"description": "Revolutionary extension that uses Low Quality Image Placeholders (LQIP) method coupled with a custom pure JavaScript library to Lazy-load all posted images. Including avatars, signatures, PM images, preview and more.",
	"homepage": "https://sitesplat.com",
	"version": "1.0.9",
	"keywords": ["phpbb", "extension", "lazyloading", "BBOOTS", "FLATBOOTS", "sitesplat"],
	"license": "Proprietary/All rights reserved",
	"authors": [
		{
			"name": "SiteSplat",
			"email": "info@sitesplat.com",
			"homepage": "https://sitesplat.com"
		}
	],
	"require": {
		"php": ">=5.4",
		"composer/installers": "~1.0"
	},
	"extra": {
		"display-name": "BBlazy",
		"soft-require": {
			"phpbb/phpbb": ">=3.2.6"
		},
		"version-check": {
            "host": "sitesplat.com",
            "directory": "/updatecheck/phpbb32/ext",
            "filename": "bblazy.json",
			"ssl": true
		}

	}
}
