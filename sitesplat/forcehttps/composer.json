{
	"name": "sitesplat/forcehttps",
	"type": "phpbb-extension",
	"description": "Takes care of HTTPS various settings around the phpBB board. This assumes you have already installed a SSL certificate correctly first! Did you??!",
	"homepage": "https://sitesplat.com",
	"version": "1.0.1",
	"keywords": ["sitesplat", "phpbb", "extension", "ssl", "security", "https"],
	"license": "@license Proprietary",
	"authors": [
		{
			"name": "Dave - SiteSplat",
			"email": "info@sitesplat.com",
            "homepage": "https://sitesplat.com",
			"role": "Developer"
		}
	],
	"require": {
		"php": ">=5.4.0",
		"phpbb/phpbb": ">=3.2.0"
	},
	"extra": {
		"display-name": "BBssl",
		"soft-require": {
           "phpbb/phpbb": ">=3.2.0"
        },
		"version-check": {
            "host": "sitesplat.com",
            "directory": "/updatecheck/phpbb32/ext",
            "filename": "bbssl.json",
			"ssl": true
		}
	}
}
