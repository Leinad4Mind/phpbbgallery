{
	"name": "sitesplat/accountswitch",
	"type": "phpbb-extension",
	"description": "Adds an Account switch for phpBB 3.1 and 3.2. Allows users to register multiple accounts and switch between them live via a simple click.",
	"homepage": "http://sitesplat.com",
	"version": "1.0.2",
	"keywords": ["sitesplat", "phpbb", "extension", "bbswitch", "accounts", "ucp"],
	"license": "Proprietary/All rights reserved",
	"authors": [
		{
			"name": "SiteSplat",
			"email": "info@sitesplat.com",
			"homepage": "http://sitesplat.com"
		}
	],
	"require": {
		"php": ">=5.3.3",
		"composer/installers": "~1.0"
	},
	"extra": {
		"display-name": "BBswitch",
		"soft-require": {
           "phpbb/phpbb": "3.1.*@dev"
        },
		"version-check": {
			"host": "www.sitesplat.com",
            "directory": "/updatecheck/phpbb31/ext",
            "filename": "bbswitch.json"
		}
	}
}