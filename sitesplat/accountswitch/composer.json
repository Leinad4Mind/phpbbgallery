{
	"name": "sitesplat/accountswitch",
	"type": "phpbb-extension",
	"description": "Adds an Account switch for phpBB. Allows users to register multiple accounts and switch between them live via a simple click.",
	"homepage": "https://sitesplat.com",
	"version": "1.0.3",
	"keywords": ["sitesplat", "phpbb", "extension", "bbswitch", "accounts", "ucp"],
	"license": "Proprietary/All rights reserved",
	"authors": [
		{
			"name": "SiteSplat",
			"email": "info@sitesplat.com",
			"homepage": "https://sitesplat.com"
		}
	],
	"require": {
		"php": ">=5.4",
		"composer/installers": "~1.0"
	},
	"extra": {
		"display-name": "BBswitch",
		"soft-require": {
           "phpbb/phpbb": "3.2.*@dev"
        },
		"version-check": {
			"host": "sitesplat.com",
            "directory": "/updatecheck/phpbb32/ext",
            "filename": "bbswitch.json",
			"ssl": true
		}
	}
}