{
    "name": "sitesplat/bookmarkpost",
    "type": "phpbb-extension",
    "description": "Allows user to bookmark a single post. Comes with a handy UCP module to review single bookmarks as well.",
    "homepage": "https://sitesplat.com",
    "version": "1.0.6",
    	"keywords": ["phpbb", "extension", "ucp", "bookmark", "cosmetic", "sitesplat"],
	"license": "@license Proprietary",
    "authors": [
        {
            "name": "SiteSplat",
            "email": "info@sitesplat.com",
            "homepage": "https://sitesplat.com"
        }
    ],
    "require": {
        "php": ">=5.4"
    },
    "extra": {
        "display-name": "BookmarkPost",
        "soft-require": {
            "phpbb/phpbb": ">=3.1.3,<3.3.0@dev"
        },
		"version-check": {
			"host": "sitesplat.com",
            "directory": "/updatecheck/phpbb32/ext",
            "filename": "bookmark.json",
			"ssl": true
		}
    }
}