{
	"name": "sitesplat/sidebar",
	"type": "phpbb-extension",
	"description": "This extension adds a flexible multi-block system for your forum. Tons of options available and it comes with many modern blocks by default",
	"homepage": "http://sitesplat.com",
	"version": "1.3.4",
	"keywords": ["phpbb", "extension", "sidebar", "sideblock", "sitesplat", "premium"],
	"license": "Proprietary/All rights reserved",
	"authors": [
		{
			"name": "SiteSplat",
			"email": "info@sitesplat.com",
			"homepage": "http://sitesplat.com"
		}
	],
	"require": {
		"php": ">=5.3.3",
		"composer/installers": "~1.0"
	},
	"require-dev": {
		"phpbb/epv": "dev-master"
	},
	"extra": {
		"display-name": "BBsidebar",
		"soft-require": {
			"phpbb/phpbb": ">=3.1.3, <3.2.*@dev"
		},
		"version-check": {
            "host": "www.sitesplat.com",
            "directory": "/updatecheck/phpbb31/ext",
            "filename": "bbsidebar.json"
		}
	}
}

