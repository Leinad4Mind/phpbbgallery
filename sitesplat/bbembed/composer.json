{
	"name": "sitesplat/bbembed",
	"type": "phpbb-extension",
	"description": "It allows the automatic embedding of videos and tweets - Supported social medias are: Twitter, Youtube, Twitch, Vimeo, SoundCloud, Medium and FaceBook. The medias are also Responsive by default.",
	"version": "1.1.2",
	"keywords": ["phpbb", "extension", "embed", "media"],
	"license": "Proprietary/All rights reserved",
	"authors": [
		{
			"name": "SiteSplat",
			"email": "info@sitesplat.com",
			"homepage": "https://sitesplat.com"
		}
	],
	"require": {
		"php": ">=5.4",
		"composer/installers": "~1.0"
	},
	"extra": {
		"display-name": "BBembed",
		"soft-require": {
			"phpbb/phpbb": ">=3.1.*"
		},
		"version-check": {
            "host": "sitesplat.com",
            "directory": "/updatecheck/phpbb32/ext",
            "filename": "bbembed.json",
			"ssl": true
		}
	}
}