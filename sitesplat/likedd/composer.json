{
	"name": "sitesplat/likedd",
	"type": "phpbb-extension",
	"description": "An extension for like / dislike posts, Ajax driven(real time user interaction).",
	"homepage": "http://sitesplat.com",
	"version": "2.3.0",
	"keywords": ["phpbb", "extension", "likeBB", "Ajax", "like", "dislike", "award"],
	"license": "Proprietary/All rights reserved",
	"authors": [
		{
			"name": "Dave",
			"email": "info@sitesplat.com",
			"homepage": "http://sitesplat.com",
			"role": "Developer"
		}
	],
	"require": {
		"php": ">=5.3.3",
		"composer/installers": "~1.0"
	},
	"require-dev": {
		"phpbb/epv": "dev-master"
	},
	"extra": {
		"display-name": "LikeBB",
		"soft-require": {
			"phpbb/phpbb": ">=3.1.0,<3.2.*@dev"
		},
		"version-check": {
            "host": "www.sitesplat.com",
            "directory": "/updatecheck/phpbb31/ext",
            "filename": "likebb.json"
		}

	}
}
