{
    "name": "sitesplat/subjectcheck",
    "type": "phpbb-extension",
    "description": "When a new topic is attempted, a list of topics with similar subjects will first be displayed along with a message urging the user to see if perhaps this new topic is not needed. Includes AJAX support.",
    "homepage": "http://www.sitesplat.com",
    "version": "1.0.3",
    "keywords": ["phpbb", "extension", "BBcore", "BBOOTS", "FLATBOOTS", "sitesplat"],
    "license": "Proprietary/All rights reserved",
    "authors": [
        {
            "name": "SiteSplat",
            "email": "info@sitesplat.com",
            "homepage": "http://sitesplat.com"
        }
    ],
    "require": {
        "php": ">=5.3.3",
        "composer/installers": "~1.0"
    },
    "extra": {
        "display-name": "Subject Check",
        "soft-require": {
            "phpbb/phpbb": ">=3.1.0,<3.3.0@dev"
        },
		"version-check": {
            "host": "sitesplat.com",
            "directory": "/updatecheck/phpbb31/ext",
            "filename": "subjectcheck.json"
		}
    }
}