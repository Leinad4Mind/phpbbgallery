{
    "name": "sitesplat/cas",
    "type": "phpbb-extension",
    "description": "This extension will separate the topics in viewforum into Global Announcements, Announcements, Stickies and Normal Topics.",
    "homepage": "http://www.sitesplat.com",
    "version": "1.0.1",
    "license": "Proprietary/All rights reserved",
    "authors": [
        {
            "name": "SiteSplat",
            "email": "info@sitesplat.com",
            "homepage": "http://sitesplat.com"
        }
    ],
    "require": {
        "php": ">=5.3.3",
        "composer/installers": "~1.0"
    },
    "extra": {
        "display-name": "Categorize Announcements and Stickies",
        "soft-require": {
            "phpbb/phpbb": ">=3.1.0,<3.3.0@dev"
        },
		"version-check": {
            "host": "sitesplat.com",
            "directory": "/updatecheck/phpbb32/ext",
            "filename": "cas.json"
		}
    }
}