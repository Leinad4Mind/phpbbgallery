{
    "name": "sitesplat/bbbreadcrumbs",
    "type": "phpbb-extension",
    "description": "Extends breadcrumbs to support all pages.",
    "homepage": "http://sitesplat.com",
    "version": "1.0.0",
    "license": "Proprietary/All rights reserved",
    "authors": [
        {
            "name": "SiteSplat",
            "email": "info@sitesplat.com",
            "homepage": "http://sitesplat.com"
        }
    ],
    "require": {
        "php": ">=5.5",
        "composer/installers": "~1.0"
    },
    "extra": {
        "display-name": "BBbreadcrumbs",
        "soft-require": {
            "phpbb/phpbb": ">=3.1.0,<3.3.0@dev"
        },
		"version-check": {
            "host": "sitesplat.com",
            "directory": "/updatecheck/phpbb31/ext",
            "filename": "breadcrumbs.json"
		}
    }
}