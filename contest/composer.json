{
	"name": "phpbbgallery/contest",
	"type": "phpbb-extension",
	"description": "Contest albums for phpBB Gallery",
	"homepage": "https://github.com/satanasov/phpbbgallery",
	"version": "1.0.0",
	"time": "2026-08-02",
	"license": "GPL-2.0-only",
	"authors": [
		{
			"name": "Leinad4Mind",
			"homepage": "https://www.leinad4mind.top/forum",
			"role": "Extension Developer"
		},
		{
			"name": "Joas Schilling",
			"role": "Original Gallery Contest Author"
		}
	],
	"require": {
		"php": ">=8.1"
	},
	"require-dev": {
		"phpunit/phpunit": "^10.5"
	},
	"scripts": {
		"test": "phpunit -c phpunit.xml.dist"
	},
	"extra": {
		"display-name": "phpBB Gallery Add-on: Contests",
		"soft-require": {
			"phpbb/phpbb": ">=3.3.0,<4.0.0@dev",
			"phpbbgallery/core": ">=4.1.0,<5.0.0@dev"
		},
		"version-check": {
			"host": "raw.githubusercontent.com",
			"directory": "/satanasov/phpbbgallery/master/",
			"filename": "gallery-contest.json",
			"ssl": true
		}
	}
}
