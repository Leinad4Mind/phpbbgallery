{
	"name": "kirk/subjectreadonly",
	"type": "phpbb-extension",
	"description": "Prevents changing the subject when replying to a post.",
	"homepage": "https://kirk-phpbb.com/viewtopic.php?t=494",
	"version": "1.0.0",
	"time": "2025-01-25",
	"license": "GPL-2.0-only",
	"authors": [
		{
			"name": "Kirk",
			"email": " kirk@kirk-phpbb.com",
			"homepage": "https://kirk-phpbb.com",
			"role": " Lead Developer"
		}
	],
	"require": {
		"php": ">=7.1.3,<8.5.0@dev",
		"composer/installers": "~1.0.0",
		"phpbb/phpbb": ">=3.3.0,<3.4.0@dev"
	},
	"extra": {
		"display-name": "Subject readonly",
			"soft-require": {
			"phpbb/phpbb": ">=3.3.0,<3.4.0@dev"
		},
		"version-check": {
			"host": "kirk-phpbb.com",
			"directory": "/download/phpbb_ext_updatecheck",
			"filename": "subjectreadonly.json",
			"ssl": true
		}
	}
}
