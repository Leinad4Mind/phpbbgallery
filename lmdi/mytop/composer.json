{
    "name": "lmdi/mytop",
    "type": "phpbb-extension",
    "description": "Adds a My topics item in the Quick links menu (3.1.x/3.2.x)",
    "homepage": "http://www.insecte.org/ext/readme.txt",
    "version": "1.0.12",
    "time": "2017-04-10",
    "license": "GPL-2.0",
    "authors": [
        {
            "name": "Pierre Duhem",
            "email": "pierre@duhem.com",
            "homepage": "http://www.insecte.org/ext/readme.txt",
            "role": "Extension Developer"
        },
        {
            "name": "Erwan Nader",
            "email": "ernadoo@phpbb-services.com",
            "homepage": "http://www.phpbb-services.com",
            "role": "author of the original MOD"
        }
    ],
    "require": {
        "php": ">=5.3.3",
        "composer/installers": "~1.0",
        "phpbb/phpbb": ">=3.1.0"
    },
    "extra": {
        "display-name": "LMDI My Topics",
        "soft-require": {
            "phpbb/phpbb": ">=3.1.0"
        },
        "version-check": {
            "host": "www.phpbb.com",
            "directory": "/customise/db/extension/lmdi_my_topics",
            "filename": "version_check"
        }
    }
}