{
	"name": "javiexin/nndeletepm",
	"type": "phpbb-extension",
	"description": "When a private message is deleted before being read (ie, in the outbox), it is deleted without notice to others",
	"version": "1.0.1",
	"time": "2025-08-16",
	"keywords": [
		"phpbb",
		"extension",
		"nndeletepm",
		"delete",
		"pm"
	],
	"license": "GPL-2.0",
	"authors": [
		{
			"name": "Leinad4Mind",
			"role": "Developer"
		},
		{
			"name": "Javier Lopez (javiexin)",
			"role": "Previous Developer (RIP)"
		},
		{
			"name": "JimA",
			"role": "Previous Developer"
		}
	],
	"require": {
		"php": ">=7.1.3",
		"phpbb/phpbb": ">=3.3.0,<4.0.0@dev"
	},
	"extra": {
		"display-name": "No Notice Delete PM",
		"soft-require": {
			"phpbb/phpbb": ">=3.3.0,<4.0.0@dev"
		},
		"version-check": {
			"host": "www.phpbb.com",
			"directory": "/customise/db/extension/no_notice_delete_unread_pms",
			"filename": "version_check"
		}
	}
}
