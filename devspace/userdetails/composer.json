{
	"name": "devspace/userdetails",
	"type": "phpbb-extension",
	"description": "Adds an ACP lisitng of selectable user details.",
	"version": "3.3.0",
	"time": "2022-10-28",
		"keywords": [
			"phpbb",
			"extension",
			"user"
		],
	"license": "GPL-2.0-only",
	"authors": [{
	 	"name": "devspace",
		"role": "Maintainer"
    },
	{
		"name": "David Wood (david63)",
		"role": "Developer"
	}],
	"require": {
        "php": ">=7.1.3",
        "composer/installers": "~1.0"
    },
    "require-dev": {
        "phpbb/epv": "dev-master"
    },
	"extra": {
		"display-name": "[devspace] User details",
		"soft-require": {
			"phpbb/phpbb": ">=3.3.0,<4.0.0@dev"
    	},
		"version-check": {
        	"host": "version.phpbbdev.space",
        	"directory": "/versions/devspace",
        	"filename": "user_details_version_file.json",
			"ssl": true
    	}
	}
}
