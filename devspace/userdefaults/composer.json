{
	"name": "devspace/userdefaults",
	"type": "phpbb-extension",
	"description": "Allows an Admin to set the default user settings for new users.",
	"version": "3.3.0",
	"time": "2022-10-26",
	"keywords": [
		"user",
		"defaults",
		"settings"
	],
	"license": "GPL-2.0-only",
	"authors": [{
	 	"name": "devspace",
		"role": "Maintainer"
    },
	{
		"name": "David Wood (david63)",
		"role": "Developer"
	}],
	"require": {
        "php": ">=7.1.3",
        "composer/installers": "~1.0"
    },
	"extra": {
		"display-name": "[devspace] New user default settings",
		"soft-require": {
			"phpbb/phpbb": ">=3.3.0,<4.0.0@dev"
      	},
		"version-check": {
        	"host": "version.phpbbdev.space",
        	"directory": "/versions/devspace",
        	"filename": "user_defaults_version_file.json",
			"ssl": true
    	}
	}
}
