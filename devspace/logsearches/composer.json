{
	"name": "devspace/logsearches",
	"type": "phpbb-extension",
	"description": "Creates a log of searched enquiries.",
	"version": "3.3.0",
	"time": "2022-10-29",
	"keywords": [
		"phpbb",
		"extension",
		"search",
		"ACP"
	],
	"license": "GPL-2.0-only",
	"authors": [{
	 	"name": "devspace",
		"role": "Maintainer"
    },
	{
		"name": "David Wood (david63)",
			"role": "Developer"
		}],
	"require": {
        "php": ">=7.3.1",
		"phpbb/phpbb": ">=3.3.0",
        "composer/installers": "~1.0"
    },
	"extra": {
		"display-name": "[devspace] Log searches",
		"soft-require": {
			"phpbb/phpbb": ">=3.3.0,<4.0.0@dev"
		},
		"version-check": {
        	"host": "version.phpbbdev.space",
        	"directory": "/versions/devspace",
        	"filename": "log_searches_version_file.json",
			"ssl": true
    	}
	}
}
