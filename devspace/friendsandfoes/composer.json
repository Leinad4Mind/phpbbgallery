{
	"name": "devspace/friendsandfoes",
	"type": "phpbb-extension",
	"description": "Adds an Admin option to display the friends & foes of each member (where set).",
	"version": "3.3.0",
	"time": "2022-10-22",
	"license": "GPL-2.0-only",
	"authors": [{
	 	"name": "devspace",
		"role": "Maintainer"
    },
	{
		"name": "David Wood (david63)",
		"role": "Developer"
	}],
	"require": {
        "php": ">=7.1.3",
        "composer/installers": "~1.0"
    },
	"extra": {
		"display-name": "[devspace] Friends and foes",
		"soft-require": {
        	"phpbb/phpbb": ">=3.3.0,<4.0.0@dev"
		},
			"version-check": {
			"host": "version.phpbbdev.space",
			"directory": "/versions/devspace",
			"filename": "friends_and_foes_version_file.json",
			"ssl": true
		}
	}
}
