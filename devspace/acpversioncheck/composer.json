{
	"name": "devspace/acpversioncheck",
	"type": "phpbb-extension",
	"description": "Displays the status of the board phpBB versions.",
	"version": "3.3.0",
	"time": "2022-10-17",
	"keywords": [
		"ACP",
		"version",
		"check"
	],
	"license": "GPL-2.0-only",
	"authors": [{
			"name": "devspace",
			"role": "Maintainer"
        },
		{
			"name": "David Wood (david63)",
			"role": "Developer"
		}],
	"require": {
        "php": ">=8.0.0",
        "composer/installers": "~1.0"
    },
	"extra": {
        "display-name": "[devspace] ACP version check",
        "soft-require": {
            "phpbb/phpbb": ">=3.3.5,<4.1.0"
        },
		"version-check": {
        	"host": "version.phpbbdev.space",
        	"directory": "/versions/devspace",
        	"filename": "acp_versioncheck_version_file.json",
			"ssl": true
    	}
	}
}
