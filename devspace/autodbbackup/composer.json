{
	"name": "devspace/autodbbackup",
	"type": "phpbb-extension",
	"description": "An extension for phpBB that will automatically backup your database using the phpBB Cron.",
	"version": "3.3.0",
	"time": "2022-10-14",
	"keywords": [
		"phpbb",
		"extension",
		"auto",
		"database",
		"backup"
	],
	"license": "GPL-2.0-only",
	"authors": [{
	 	"name": "devspace",
		"role": "Maintainer"
    },
	{
		"name": "David Wood (david63)",
		"role": "phpBB 3.2 Updater"
	},
	{
		"name": "Lukasz Kaczynski",
        "role": "Original Developer"
	}],
	"require": {
        "php": ">=7.1.3",
        "composer/installers": "~1.0"
    },
	"extra": {
		"display-name": "[devspace] Auto database backup",
		"soft-require": {
			"phpbb/phpbb": ">=3.3.0,<4.0.0@dev"
		},
		"version-check": {
        	"host": "version.phpbbdev.space",
        	"directory": "/versions/devspace",
        	"filename": "auto_db_backup_version_file.json",
			"ssl": true
    	}
	}
}
