{
    "name": "javiexin/nndeletepm",
    "type": "phpbb-extension",
    "description": "When a post is deleted before being sent (ie, in the outbox), it is deleted without notice to others",
    "version": "1.0.0",
    "time": "2016-11-18",
    "keywords": [
        "phpbb",
        "extension",
        "nndeletepm",
        "delete",
        "pm"
    ],
    "license": "GPL-2.0",
    "authors": [
        {
            "name": "Javier Lopez (javiexin)",
            "email": "javiexin@gmail.com",
            "role": "Developer"
        },
        {
            "name": "JimA",
            "role": "Previous Developer"
        }
    ],
    "require": {
        "php": ">=7.1.3",
        "phpbb/phpbb": ">=3.3.0,<4.0.0@dev"
    },
    "extra": {
        "display-name": "No Notice Delete PM",
        "soft-require": {
            "phpbb/phpbb": ">=3.3.0,<4.0.0@dev"
        },
        "version-check": {
            "host": "www.phpbb.com",
            "directory": "/customise/db/extension/no_notice_delete_unread_pms",
            "filename": "version_check"
        }
    }
}
