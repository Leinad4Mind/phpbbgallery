{
	"name": "forumhulp/pmspy",
	"type": "phpbb-extension",
	"description": "Show PMs of your members, delete them if you want.",
	"homepage": "http://forumhulp.com",
	"version": "3.3.0",
	"keywords": ["forumhulp", "phpbb", "extension", "add user", "pb"],
	"license": "GPL-2.0-only",
	"authors": [
		{
			"name": "John Peskens",
			"homepage": "http://forumhulp.com",
			"email": "info@forumhulp.com",
			"role": "Developer"
		}
	],
	"require": {
		"php": ">=7.1.3",
		"composer/installers": "~1.0"
	},
	"extra": {
		"display-name": "PM Spy",
		"soft-require": {
           "phpbb/phpbb": ">=3.3.0"
        },
		"version-check": {
			"host": "forumhulp.com",
			"directory": "/ext",
			"filename": "index.php?id=74"
		}
	}
}
