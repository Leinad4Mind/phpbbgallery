{
	"name": "phpbbgallery/remotestorage",
	"type": "phpbb-extension",
	"description": "Private remote object storage providers for phpBB Gallery",
	"homepage": "https://github.com/satanasov/phpbbgallery",
	"version": "1.0.0",
	"time": "2026-08-05",
	"license": "GPL-2.0-only",
	"authors": [
		{
			"name": "Leinad4Mind",
			"homepage": "https://www.leinad4mind.top/forum",
			"role": "Extension Developer"
		}
	],
	"require": {
		"php": ">=8.1",
		"ext-simplexml": "*"
	},
	"require-dev": {
		"phpunit/phpunit": "^10.5"
	},
	"scripts": {
		"test": "phpunit -c phpunit.xml.dist"
	},
	"extra": {
		"display-name": "phpBB Gallery Add-on: Remote Storage",
		"soft-require": {
			"phpbb/phpbb": ">=3.3.0,<4.0.0@dev"
		}
