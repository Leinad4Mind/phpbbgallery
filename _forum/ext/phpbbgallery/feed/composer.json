{
	"name": "phpbbgallery/feed",
	"type": "phpbb-extension",
	"description": "This phpBB Gallery Add-on publishes an ATOM feed of the Gallery images",
	"homepage": "https://github.com/Leinad4Mind/gold-phpbb-ext",
	"version": "1.0.0",
	"time": "2026-07-26",
	"license": "GPL-2.0-only",
	"authors": [
		{
			"name": "Leinad4Mind",
			"homepage": "https://www.leinad4mind.top/forum",
			"role": "Extension Developer"
		}
	],
	"require": {
		"php": ">=8.1"
	},
	"require-dev": {
		"phpunit/phpunit": "^10.5"
	},
	"scripts": {
		"test": "phpunit -c phpunit.xml.dist"
	},
	"extra": {
		"display-name": "phpBB Gallery Add-on: Feed",
		"soft-require": {
			"phpbb/phpbb": ">=3.3.0,<4.0.0@dev"
		}
	},
	"version-check": {
		"host": "raw.githubusercontent.com",
		"directory": "/Leinad4Mind/gold-phpbb-ext/master/",
		"filename": "gallery-feed.json",
		"ssl": true
	}
}
