{
	"name": "wolfsblvt/advancedpolls",
	"type": "phpbb-extension",
	"description": "Advances the core poll system of phpBB with new features like hiding votes till end, showing poll voters, limiting the votes and more.",
	"homepage": "https://github.com/jasoloz/advancedpolls",
	"version": "1.4.0",
	"time": "2026-08-07",
	"keywords": [
		"phpbb",
		"extension",
		"advancedpolls",
		"advanced",
		"poll"
	],
	"license": "GPL-2.0",
	"authors": [
		{
			"name": "Leinad4Mind",
			"role": "Developer"
		},
		{
			"name": "José Alfonso Solera (jasolo)",
			"role": "Developer"
		},
		{
			"name": "Javier Lopez (javiexin)",
			"role": "Previous Developer"
		},
		{
			"name": "Clemens Husung (Wolfsblvt)",
			"role": "Main Developer"
		}
	],
	"require": {
		"php": ">=7.1.3"
	},
	"require-dev": {
		"phpbb/epv": "dev-master",
		"codeclimate/php-test-reporter": "dev-master"
	},
	"extra": {
		"display-name": "Advanced Polls",
		"soft-require": {
			"phpbb/phpbb": ">=3.3.0,<4.0.0@dev"
		},
		"version-check": {
			"host": "leinad4mind.github.io",
			"directory": "/advancedpolls",
			"filename": "version.json",
			"ssl": true
		}
	}
}
