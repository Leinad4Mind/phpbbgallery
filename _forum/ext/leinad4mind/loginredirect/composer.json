{
	"name": "leinad4mind/loginredirect",
	"type": "phpbb-extension",
	"description": "Redirects users after login to an authorized welcome, announcement, or group topic.",
	"version": "3.3.0",
	"time": "2026-08-01",
	"keywords": ["phpbb", "extension", "login", "redirect"],
	"license": "GPL-2.0-only",
	"authors": [
		{ "name": "Leinad4Mind", "role": "Developer and Maintainer" },
		{ "name": "David Wood", "role": "Original Extension Converter" },
		{
			"name": "Mark Barnes",
			"email": "markthedaemon@gmail.com",
			"role": "Original Developer"
		}
	],
	"require": {
		"php": ">=7.2.0",
		"composer/installers": "~1.0"
	},
	"extra": {
		"display-name": "[Leinad4Mind] Login redirect",
		"soft-require": {
			"phpbb/phpbb": ">=3.3.0,<4.0.0@dev"
		},
		"version-check": {
			"host": "version.phpbbdev.space",
			"directory": "/versions",
			"filename": "login_redirect_version_file.json",
			"ssl": true
		}
	}
}
