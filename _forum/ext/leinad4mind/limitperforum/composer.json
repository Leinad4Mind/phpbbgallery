{
    "name": "leinad4mind/limitperforum",
    "type": "phpbb-extension",
    "description": "It allows you to limit the count of messages and/or topics of an user per forum",
    "homepage": "https://leinad4mind.top/forum",
    "version": "1.0.1",
    "time": "2019-08-08",
    "license": "GPL-2.0-only",
    "authors": [
        {
            "name": "leinad4mind",
            "homepage": "https://leinad4mind.top/forum",
            "role": "Extension Developer"
        }
    ],
    "require": {
        "php": ">=5.4.7",
        "composer/installers": "~1.0"
    },
    "extra": {
        "display-name": "Limit Posts and Topics per Forum",
        "soft-require": {
            "phpbb/phpbb": ">=3.2.0"
        },
		"version-check": {
			"host": "leinad4mind.top",
			"directory": "/phpbb/limitperforum",
			"filename": "version_check"
		}
    }
}
