{
    "name": "leinad4mind/stickyelements",
    "type": "phpbb-extension",
    "description": "This extension adds buttons that stick to the right side of the page on every page of the board or only on the index page.",
    "homepage": "https://leinad4mind.top/forum",
    "version": "1.0.2",
    "time": "2019-02-10",
    "license": "GPL-2.0",
    "authors": [
		{
			"name": "Leinad4Mind",
			"homepage": "https://leinad4mind.top/forum",
			"role": "Developer"
		}
    ],
    "require": {
        "php": ">=5.6.0",
        "composer/installers": "~1.0"
    },
    "extra": {
        "display-name": "Sticky Elements",
        "soft-require": {
            "phpbb/phpbb": ">=3.2.0"
		},
        "version-check": {
            "host": "leinad4mind.top",
            "directory": "/phpbb/stickyelements",
            "filename": "version_check.json",
            "ssl": true
        }
    }
}
