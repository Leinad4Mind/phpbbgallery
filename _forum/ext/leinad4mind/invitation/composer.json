{
    "name": "leinad4mind/invitation",
    "type": "phpbb-extension",
    "description": "This extension allows users to invite friends to your board. You can make your board private where registration is by invitation only.",
    "homepage": "http://leinad4mind.top/forum",
    "version": "4.3.0",
    "time": "2022-09-30",
    "keywords": [
        "phpbb",
        "extension",
        "invite"
    ],
    "license": "GPL-2.0-only",
    "authors": [
        {
            "name": "Leinad4Mind",
            "role": "Extension Developer"
        },
        {
            "name": "kasimi",
            "role": "Extension Developer"
        },
        {
            "name": "KillBill",
            "role": "MOD Developer"
        },
        {
            "name": "Scanialady",
            "role": "Translator en, de, de_x_sie"
        },
        {
            "name": "bkat",
            "role": "Translator fr"
        },
        {
            "name": "wizzzzzzzz",
            "role": "Translator nl"
        }
    ],
    "require": {
        "php": ">=5.4.7"
    },
    "extra": {
        "display-name": "Invitation",
        "soft-require": {
            "phpbb/phpbb": ">=3.2.2"
        },
        "version-check": {
            "host": "leinad4mind.top",
            "directory": "/phpbb/invitation",
            "filename": "version_check_32.json",
            "ssl": true
        }
    }
}
