{
	"name": "leinad4mind/htmlemail",
	"type": "phpbb-extension",
	"description": "Forces HTML format on all emails and provides an advanced ACP editor to manage all email templates.",
	"homepage": "https://leinad4mind.top",
	"version": "3.4.0",
	"keywords": [
		"phpbb",
		"extension",
		"HTML",
		"Email"
	],
	"license": "GPL-2.0",
	"authors": [
		{
			"name": "John Peskens",
			"role": "Original Developer"
		},
		{
			"name": "Leinad4Mind",
			"role": "Current Developer"
		}
	],
	"require": {
		"php": ">=8.0.0",
		"composer/installers": "~1.0"
	},
	"extra": {
		"display-name": "HTML Email",
		"soft-require": {
			"phpbb/phpbb": ">=3.3.0,<3.3.*@dev"
		},
		"version-check": {
			"host": "leinad4mind.top",
			"directory": "/phpbb/htmlemail",
			"filename": "version_check"
		}
	}
}
