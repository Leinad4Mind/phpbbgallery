{
    "name": "leinad4mind/topicstatistics",
    "type": "phpbb-extension",
    "description": "Adds a block to the forum and/or topic page including viewers, followers and bookmarks, optionally also display followers users and bookmarks users",
    "homepage": "https://leinad4mind.top/forum",
    "version": "1.0.2",
    "time": "2022-05-17",
    "license": "GPL-2.0-only",
    "authors": [
        {
            "name": "leinad4mind",
            "homepage": "https://leinad4mind.top/forum",
            "role": "Extension Developer"
        }
    ],
    "require": {
        "php": ">=5.4.7",
        "composer/installers": "~1.0"
    },
    "extra": {
        "display-name": "Topic Statistics",
        "soft-require": {
            "phpbb/phpbb": ">=3.2.2"
        },
        "version-check": {
            "host": "leinad4mind.top",
            "directory": "/phpbb/topicstatistics",
            "filename": "version_check.json",
            "ssl": true
        }
    }
}
