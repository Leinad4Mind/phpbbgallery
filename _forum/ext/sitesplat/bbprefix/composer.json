{
    "name": "sitesplat/bbprefix",
    "type": "phpbb-extension",
    "description": "BBprefix allows to use topic prefix tags. It supports out of the box BBcode functionality to mark the prefixes and comes with several useful ACP options.",
    "homepage": "http://sitesplat.com",
    "version": "1.0.6",
	"keywords": ["phpbb", "prefix", "extension", "topic", "sitesplat"],
    "license": "Proprietary/All rights reserved",
    "authors": [
        {
			"name": "SiteSplat",
			"email": "info@sitesplat.com",
			"homepage": "http://sitesplat.com"
        }
    ],
    "require": {
        "php": ">=5.4"
    },
	"require-dev": {
		"phpbb/epv": "dev-master"
	},
    "extra": {
        "display-name": "BBprefix",
		"soft-require": {
            "phpbb/phpbb": "3.1.*@dev"
		},
		"version-check": {
            "host": "www.sitesplat.com",
            "directory": "/updatecheck/phpbb32/ext",
            "filename": "bbprefix.json"
		}
    }
}
