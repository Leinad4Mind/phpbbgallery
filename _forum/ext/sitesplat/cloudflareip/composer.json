{
	"name": "sitesplat/cloudflareip",
	"type": "phpbb-extension",
	"description": "This extension normalizes user IP addresses while your server is under Cloudflare proxy.",
	"homepage": "http://sitesplat.com",
	"version": "1.1.1",
	"keywords": ["sitesplat", "phpbb", "extension", "ip", "users", "security", "tools"],
	"license": "Proprietary/All rights reserved",
	"authors": [
		{
			"name": "SiteSplat",
			"email": "info@sitesplat.com",
			"homepage": "http://sitesplat.com"
		}
	],
	"require": {
		"php": ">=5.3.3",
		"composer/installers": "~1.0",
		"jamesryanbell/cloudflare": "^1.10"
	},
	"extra": {
		"display-name": "CloudFlare IP",
		"soft-require": {
			"phpbb/phpbb": ">3.1.10"
		},
		"version-check": {
            "host": "sitesplat.com",
            "directory": "/updatecheck/phpbb32/ext",
            "filename": "cloudflare.json",
			"ssl": true
		}
	}
}
