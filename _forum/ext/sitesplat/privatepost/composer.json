{
    "name": "sitesplat/privatepost",
    "type": "phpbb-extension",
    "description": "Allows users to submit private posts that only selected groups can read.",
    "homepage": "http://sitesplat.com",
    "version": "1.0.0",
    "license": "Proprietary/All rights reserved",
    "authors": [
        {
            "name": "SiteSplat",
            "email": "info@sitesplat.com",
            "homepage": "http://sitesplat.com"
        }
    ],
    "require": {
        "php": ">=5.3.3"
    },
    "extra": {
        "display-name": "Private Post",
        "soft-require": {
            "phpbb/phpbb": ">=3.1.3,<3.3.0@dev"
        },
		"version-check": {
            "host": "sitesplat.com",
            "directory": "/updatecheck/phpbb32/ext",
            "filename": "privatepost.json",
			"ssl": true
		}
    }
}