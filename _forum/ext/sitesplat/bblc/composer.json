{
    "name": "sitesplat/bblc_giphy",
    "type": "phpbb-extension",
    "description": "An addon for BBlivechat that adds a button to insert Giphy GIF images",
	"homepage": "https://sitesplat.com",
    "version": "1.0.0",
	"keywords": ["sitesplat", "bblivechat", "addon"],
	"license": "Proprietary/All rights reserved",
	"authors": [
		{
			"name": "SiteSplat",
			"email": "info@sitesplat.com",
			"homepage": "https://sitesplat.com"
		}
	],
    "require": {
        "php": ">=5.6",
        "composer/installers": "~1.0"
    },
    "extra": {
        "display-name": "BBlivechat Giphy Support",
        "soft-require": {
            "phpbb/phpbb": ">=3.2.4"
        },
		"version-check": {
            "host": "sitesplat.com",
            "directory": "/updatecheck/phpbb32/ext",
            "filename": "bblivechat_giphy.json",
			"ssl": true
		}
    }
}
