{
    "name": "sitesplat/bbajaxnews",
    "type": "phpbb-extension",
    "description": "BBajaxnews is a powerful and revolutionary extension allows your phpBB forum running SiteSplat premium products to have real live notifications for your users with at almost 0 server resources expense!",
	"homepage": "http://sitesplat.com",
    "version": "1.0.0",
	"keywords": ["phpbb", "extension", "news", "ajax"],
	"license": "Proprietary/All rights reserved",
	"authors": [
		{
			"name": "SiteSplat",
			"email": "info@sitesplat.com",
			"homepage": "http://sitesplat.com"
		}
	],
    "require": {
        "php": ">=7.0",
        "composer/installers": "~1.0",
        "pubnub/pubnub": "^4.0",
        "pusher/pusher-php-server": "^3.1"
    },
    "extra": {
        "display-name": "BBajaxnews",
        "soft-require": {
            "phpbb/phpbb": ">=3.2.0"
        },
		"version-check": {
            "host": "sitesplat.com",
            "directory": "/updatecheck/phpbb32/ext",
            "filename": "bbajaxnews.json"
		}
    }
}
