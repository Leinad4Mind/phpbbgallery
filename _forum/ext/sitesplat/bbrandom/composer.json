{
	"name": "sitesplat/bbrandom",
	"type": "phpbb-extension",
	"description": "Allows a Random Gravatar avatars for newly registered users and also selectable in UCP. It also allows custom avatars that will be assigned randomly for newly registered users",
	"homepage": "http://sitesplat.com",
	"version": "1.1.0",
	"keywords": ["phpbb", "extension", "gravatars", "avatar", "UCP", "cosmetic", "sitesplat"],
	"license": "@license Proprietary",
	"authors": [
		{
			"name": "SiteSplat",
			"email": "info@sitesplat.com",
			"homepage": "http://sitesplat.com"
		}
	],
	"require": {
		"php": ">=5.3.3",
		"composer/installers": "~1.0"
	},
	"require-dev": {
		"phpbb/epv": "dev-master"
	},
	"extra": {
		"display-name": "BBrandom",
		"soft-require": {
			"phpbb/phpbb": ">=3.2.0,<3.3"
		},
		"version-check": {
            "host": "www.sitesplat.com",
            "directory": "/updatecheck/phpbb32/ext",
            "filename": "bbrandom.json"
		}
	}
}
