{
    "name": "sitesplat/bbfront",
    "type": "phpbb-extension",
    "description": "Adds a modern and stylish front page with selectable post to publish in different formats, like video directly playable, quotes and post snippets...",
    "homepage": "https://sitesplat.com",
	"version": "2.0.2",
	"keywords": ["sitesplat", "phpbb", "extension", "news", "portal"],
	"license": "Proprietary/All rights reserved",
    "authors": [
        {
            "name": "SiteSplat",
			"email": "info@sitesplat.com",
			"homepage": "https://sitesplat.com"
        }
    ],
    "require": {
		"php": ">=5.6",
		"composer/installers": "~1.0"
	},
	"require-dev": {
		"phpbb/epv": "dev-master"
	},
    "extra": {
        "display-name": "BBfront Advanced",
        "soft-require": {
            "phpbb/phpbb": ">=3.1.0,<3.3.*@dev"
        },
	    "version-check": {
		    "host": "sitesplat.com",
            "directory": "/updatecheck/phpbb32/ext",
            "filename": "bbfrontadvanced.json",
			"ssl": true
		}
    }
}