{
	"name": "sitesplat/bblazy",
	"type": "phpbb-extension",
	"description": "Boost your Google ranking and make your forum mobile friendly by sparing users bandwidth with BBlazy. Lazy-load all images. User posts signatures, avatars, BBcode linked images, attachments.",
	"homepage": "http://sitesplat.com",
	"version": "1.0.0",
	"keywords": ["phpbb", "extension", "BBlazy", "BBOOTS", "FLATBOOTS", "sitesplat"],
	"license": "Proprietary/All rights reserved",
	"authors": [
		{
			"name": "SiteSplat",
			"email": "info@sitesplat.com",
			"homepage": "http://sitesplat.com"
		}
	],
	"require": {
		"php": ">=5.4",
		"composer/installers": "~1.0"
	},
	"extra": {
		"display-name": "BBlazy",
		"soft-require": {
			"phpbb/phpbb": ">=3.2.4"
		},
		"version-check": {
            "host": "www.sitesplat.com",
            "directory": "/updatecheck/phpbb32/ext",
            "filename": "bblazy.json"
		}

	}
}
