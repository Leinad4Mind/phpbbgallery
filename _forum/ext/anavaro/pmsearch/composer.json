{
	"name": "anavaro/pmsearch",
	"type": "phpbb-extension",
	"description": "Adds support for searching Private Messages",
	"homepage": "https://www.phpbb.com/community/viewtopic.php?f=456&t=2263011",
	"version": "1.0.2",
	"time": "2026-07-18",
	"license": "GPL-2.0",
	"authors": [
		{
			"name": "Stanislav Atanasov",
			"email": "lucifer@anavaro.com",
			"homepage": "http://anavaro.com",
			"role": "Lead Developer"
		},
		{
			"name": "Leinad4Mind",
			"email": "leinad4mind@protonmail.com",
			"role": "Contributor"
		}
	],
	"require": {
		"php": ">=5.4,<9.0",
		"phpbb/phpbb": ">=3.2,<3.4@dev"
	},
	"require-dev": {
		"phpbb/epv": "dev-master"
	},
	"extra": {
		"display-name": "phpBB 3.2 PM Search",
		"version-check": {
			"host": "lab.anavaro.com",
			"directory": "/phpbb-ext",
			"filename": "pmsearch.json"
		},
		"soft-require": {
			"phpbb/phpbb": ">=3.2,<3.4@dev"
		}
	}
}
