{
	"name": "phpbbgallery/acpimport",
	"type": "phpbb-extension",
	"description": "This phpBB Gallery Add-on adds an ACP Import for easely import batch of images to the gallery",
	"homepage": "https://github.com/satanasov/phpbbgallery",
	"version": "1.4.0",
	"time": "2026-07-26",
	"license": "GPL-2.0-only",
	"authors": [
		{
			"name": "Leinad4Mind",
			"homepage": "https://www.leinad4mind.top/forum",
			"role": "Extension Developer"
		},
		{
			"name": "Stanislav Atanasov",
			"role": "Previous Extension Developer"
		},
		{
			"name": "Joas Schilling",
			"role": "Main MOD Author"
		}
	],
	"require": {
		"php": ">=8.1"
	},
	"require-dev": {
		"phpunit/phpunit": "^10.5"
	},
	"scripts": {
		"test": "phpunit -c phpunit.xml.dist"
	},
	"extra": {
		"display-name": "phpBB Gallery Add-on: ACP Import",
		"soft-require": {
			"phpbb/phpbb": ">=3.3.0,<4.0.0@dev"
		}
	},
	"version-check": {
		"host": "raw.githubusercontent.com",
		"directory": "/satanasov/phpbbgallery/master/",
		"filename": "gallery-import.json",
		"ssl": true
	}
}
