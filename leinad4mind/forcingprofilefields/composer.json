{
    "name": "leinad4mind/forcingprofilefields",
    "type": "phpbb-extension",
    "description": "This extension forces a user to update his profile if any required profile field has not yet been filled.",
    "homepage": "https://leinad4mind.top/forum",
    "version": "1.0.3",
    "time": "2017-11-29",
    "keywords": [ "phpbb", "extension", "force", "profile", "field", "leinad4mind" ],
    "license": "GPL-2.0",
    "authors": [
        {
            "name": "leinad4mind",
            "homepage": "https://leinad4mind.top/forum",
            "role": "Developer"
        },
        {
            "name": "kasimi",
            "role": "Original Developer"
        }
    ],
    "require": {
        "php": ">=5.4.0",
        "composer/installers": "~1.0"
    },
    "extra": {
        "display-name": "Forcing Profile Fields",
        "soft-require": {
            "phpbb/phpbb": ">=3.2.1"
        },
        "version-check": {
            "host": "leinad4mind.top",
            "directory": "/phpbb/forcingprofilefields",
            "filename": "version_check.json",
            "ssl": true
        }
    }
}