{
    "name": "leinad4mind/cronstatus",
    "type": "phpbb-extension",
    "description": "Cron Status displays an overview of Board's Cron Jobs in the Forum Logs section of the ACP. Shows a notification on the ACP index page when cron is locked, lets you run any ready task now, run all ready tasks at once, and lists tasks that have never started.",
    "homepage": "https://leinad4mind.top/forum",
    "version": "3.4.0",
    "time": "2026-07-24",
    "keywords": [
        "leinad4mind",
        "boardtools",
        "forumhulp",
        "phpbb",
        "extension",
        "cron",
        "status"
    ],
    "license": "GPL-2.0-only",
    "authors": [
        {
            "name": "Leinad4Mind",
            "homepage": "https://leinad4mind.top/forum",
            "role": "Developer"
        },
        {
            "name": "Igor Lavrov",
            "role": "Developer"
        },
        {
            "name": "John Peskens",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=7.1",
        "composer/installers": "~1.0"
    },
    "extra": {
        "display-name": "Cron Status",
        "soft-require": {
            "phpbb/phpbb": ">=3.3.0"
        },
        "version-check": {
            "host": "leinad4mind.top",
            "directory": "/phpbb/cronstatus",
            "filename": "version_check.json",
            "ssl": true
        }
    }
}
