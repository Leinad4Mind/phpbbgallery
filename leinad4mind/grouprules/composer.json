{
    "name": "leinad4mind/grouprules",
    "type": "phpbb-extension",
    "description": "This extension reacts to users being added to, removed from, promoted to and demoted from groups and allows automated adding to or removing from other groups.",
    "homepage": "https://leinad4mind.top/forum",
    "version": "1.2.0",
    "time": "2018-03-05",
    "license": "GPL-2.0",
    "authors": [
        {
            "name": "Leinad4Mind",
            "homepage": "https://leinad4mind.top/forum",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=5.4.0"
    },
    "extra": {
        "display-name": "Group Rules",
        "soft-require": {
            "phpbb/phpbb": ">=3.2.0"
        },
        "version-check": {
            "host": "leinad4mind.top",
            "directory": "/phpbb/grouprulesblocks",
            "filename": "version_check.json"
        }
    }
}
