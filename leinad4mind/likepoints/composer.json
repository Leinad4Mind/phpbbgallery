{
    "name": "leinad4mind/likepoints",
    "type": "phpbb-extension",
    "description": "Bridge between the BBPoints and LikeBB extensions",
    "homepage": "https://leinad4mind.top/forum/",
    "version": "1.0.0",
    "time": "2022-05-25",
    "keywords": [ "phpbb", "extension", "likedd", "bbpoints" ],
    "license": "Proprietary",
    "authors": [
        {
            "name": "Leinad4Mind",
            "homepage": "https://leinad4mind.top/forum",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=7.3",
        "phpbb/phpbb": ">=3.3",
        "composer/installers": "~1.0"
    },
    "extra": {
        "display-name": "BBPoints for LikeBB",
        "soft-require": {
            "phpbb/phpbb": ">=3.3"
        },
        "version-check": {
            "host": "leinad4mind.top",
            "directory": "/phpbb/likepoints",
            "filename": "version_check.json",
            "ssl": true
        }
    }
}
