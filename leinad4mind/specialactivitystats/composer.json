{
	"name": "leinad4mind/specialactivitystats",
	"type": "phpbb-extension",
	"description": "Displays statistics of the latest activities on the boards index site",
	"homepage": "https://leinad4mind.top/forum",
	"version": "1.2.5",
	"time": "2019-08-05",
	"keywords": ["phpbb", "extension", "activity stats", "statistics", "who was here"],
	"license": "GPL-2.0",
	"authors": [
		{
            "name": "Leinad4Mind",
            "homepage": "https://leinad4mind.top/forum",
            "role": "Developer"
        },
		{
			"name": "Robert Heim",
			"role": "Former Extension Port Developer"
		}
	],
	"require": {
        "php": ">=5.3.3",
        "composer/installers": "~1.0.0"
    },
	"extra": {
		"display-name": "Activity Stats",
		"soft-require": {
			"phpbb/phpbb": ">=3.2.0,<3.3.0"
		},
        "version-check": {
            "host": "leinad4mind.top",
            "directory": "/phpbb/specialactivitystats",
            "filename": "version_check"
        }
	}
}
