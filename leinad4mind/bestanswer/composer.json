{
    "name": "leinad4mind/bestanswer",
    "type": "phpbb-extension",
    "description": "An extension for phpBB 3.2.x that allows users to mark a post as the 'Best Answer', which will then be quoted in the first post with a link to it.",
    "homepage": "https://leinad4mind.top/forum",
    "version": "2.0.0",
    "time": "2017-11-30",
    "keywords": [ "phpbb", "extension", "best", "answer", "leinad4mind" ],
    "license": "GPL-2.0",
    "authors": [
        {
            "name": "Leinad4Mind",
            "homepage": "https://leinad4mind.top/forum",
            "role": "Developer"
        },
        {
            "name": "kinerity",
            "role": "Original Developer"
        }
    ],
    "require": {
        "php": ">=5.4.0",
        "phpbb/phpbb": ">=3.2.0,<3.3.0",
        "composer/installers": "~1.0"
    },
    "extra": {
        "display-name": "Best Answer Special Edition",
        "soft-require": {
            "phpbb/phpbb": ">=3.2.0,<3.3.0"
        },
        "version-check": {
            "host": "leinad4mind.top",
            "directory": "/phpbb/bestanswer_special",
            "filename": "version_check"
        }
    }
}
