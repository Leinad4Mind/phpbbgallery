{
    "name": "leinad4mind/profilefieldsearchable",
    "type": "phpbb-extension",
	"description": "This extension allows an administrator to make any custom profile field searchable. It adds new search fields on the memberlist page.",
    "homepage": "https://leinad4mind.top/forum",
    "version": "1.0.4",
    "time": "2019-04-01",
    "license": "GPL-2.0-only",
    "authors": [
        {
            "name": "Leinad4Mind",
            "homepage": "https://leinad4mind.top/forum",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=5.4.7",
        "composer/installers": "~1.0"
    },
    "extra": {
        "display-name": "Profile Field Searchable",
        "soft-require": {
            "phpbb/phpbb": ">=3.2.2"
        },
        "version-check": {
            "host": "leinad4mind.top",
            "directory": "/phpbb/profilefieldsearchable",
            "filename": "version_check.json"
        }
    }
}
