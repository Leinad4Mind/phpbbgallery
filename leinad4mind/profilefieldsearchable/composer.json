{
    "name": "leinad4mind/profilefieldsearchable",
    "type": "phpbb-extension",
    "description": "Ability to use phpBB 3.2 user search interface to search by custom profile fields.",
    "homepage": "https://leinad4mind.top/forum",
    "version": "1.0.2",
    "time": "2018-02-04",
    "license": "GPL-2.0",
    "authors": [
        {
            "name": "Leinad4Mind",
            "homepage": "https://leinad4mind.top/forum",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=5.4.0",
        "composer/installers": "~1.0"
    },
    "extra": {
        "display-name": "Profile Field Searchable",
        "soft-require": {
            "phpbb/phpbb": ">=3.2.2"
        },
        "version-check": {
            "host": "leinad4mind.top",
            "directory": "/phpbb/profilefieldsearchable",
            "filename": "version_check.json"
        }
    }
}
