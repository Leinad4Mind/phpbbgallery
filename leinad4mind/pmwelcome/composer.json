    "description": "Welcome PM for registration and activation",
    "homepage": "https://leinad4mind.top/forum/",
    "version": "1.0.3",
    "time": "2019-12-11",
    "keywords": [ "phpbb", "extension", "welcome", "pm", "registration" ],
    "license": "GPL-2.0",
    "authors": [
        {
            "name": "Leinad4Mind",
            "homepage": "https://leinad4mind.top/forum/",
            "role": "Developer"
        },
        {
            "name": "Anvar",
            "role": "Original Author"
        }
