{
	"name": "forumhulp/checkmail",
	"type": "phpbb-extension",
	"description": "Check mailaddress of your users",
	"homepage": "http://forumhulp.com",
	"version": "3.1.0",
	"keywords": ["phpbb", "extension", "mail", "members"],
	"license": "@license Proprietary",
	"authors": [
		{
            "name": "John Peskens",
            "homepage": "http://forumhulp.com",
            "email": "info@forumhulp.com",
            "role": "Developer"
		}
	],
	"require": {
		"php": ">=5.6.0",
		"composer/installers": "~1.0"
	},
	"require-dev": {
		"phpbb/epv": "dev-master"
	},
	"extra": {
		"display-name": "Checkmail",
		"soft-require": {
			"phpbb/phpbb": ">=3.1.0"
		},
		"version-check": {
			"host": "forumhulp.com",
			"directory": "/ext",
			"filename": "index.php?id=85"
		}
	}
}
